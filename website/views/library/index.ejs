<%- include('../partials/header', { title, libraryStyles }) %>
<%- include('../partials/navbar') %>

<main class="main-content library-content">
  <div class="library-container">
    <section class="library-hero">
      <div>
        <p class="library-eyebrow">EDUSTUDY · LIBRARY</p>
        <h1 class="page-title">Books &amp; Authors</h1>
        <p class="page-subtitle">Manage your library collection in one place.</p>
      </div>
      <div class="library-hero-actions">
        <a class="btn btn-outline" href="/library/authors/new">Add author</a>
        <a class="btn btn-primary" href="/library/books/new">Add book</a>
      </div>
    </section>

    <% if (errors.length) { %>
      <div class="library-alert" role="alert">
        <% errors.forEach(function(error) { %><p><%= error %></p><% }); %>
      </div>
    <% } %>

    <section class="card library-section" aria-labelledby="books-heading">
      <div class="library-section-heading">
        <div>
          <p class="library-eyebrow">COLLECTION</p>
          <h2 id="books-heading">Books <span class="library-count"><%= books.length %></span></h2>
        </div>
        <a class="library-text-link" href="/library/books/new">Add a book <span aria-hidden="true">+</span></a>
      </div>
      <% if (books.length) { %>
        <div class="library-table-wrap">
          <table class="library-table">
            <thead>
              <tr><th scope="col">Book</th><th scope="col">Price</th><th scope="col">Author ID</th><th scope="col">Actions</th></tr>
            </thead>
            <tbody>
              <% books.forEach(function(book) { %>
                <tr>
                  <td class="library-book-title">
                    <div class="library-image-cell">
                      <% if (book.cover_image) { %>
                        <img class="library-thumbnail library-cover" src="/uploads/library/<%= book.cover_image %>" alt="Cover of <%= book.title %>">
                      <% } else { %>
                        <span class="library-image-placeholder" aria-hidden="true">BOOK</span>
                      <% } %>
                      <span><%= book.title %></span>
                    </div>
                  </td>
                  <td>$<%= Number(book.price).toFixed(2) %></td>
                  <td><span class="library-id">#<%= book.author_id %></span></td>
                  <td>
                    <div class="library-row-actions">
                      <a class="library-text-link" href="/library/books/<%= book.book_id %>/edit">Edit</a>
                      <form action="/library/books/<%= book.book_id %>/delete" method="POST" onsubmit="return confirm('Remove this book?');">
                        <button class="library-danger-link" type="submit">Remove</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="library-empty">No books yet. Add the first one to get started.</p>
      <% } %>
    </section>

    <section class="card library-section" aria-labelledby="authors-heading">
      <div class="library-section-heading">
        <div>
          <p class="library-eyebrow">PEOPLE</p>
          <h2 id="authors-heading">Authors <span class="library-count"><%= authors.length %></span></h2>
        </div>
        <a class="library-text-link" href="/library/authors/new">Add an author <span aria-hidden="true">+</span></a>
      </div>
      <% if (authors.length) { %>
        <div class="library-table-wrap">
          <table class="library-table">
            <thead>
              <tr><th scope="col">Author</th><th scope="col">Country</th><th scope="col">Author ID</th><th scope="col">Actions</th></tr>
            </thead>
            <tbody>
              <% authors.forEach(function(author) { %>
                <tr>
                  <td class="library-book-title">
                    <div class="library-image-cell">
                      <% if (author.photo_image) { %>
                        <img class="library-thumbnail library-author-photo" src="/uploads/library/<%= author.photo_image %>" alt="Photo of <%= author.name %>">
                      <% } else { %>
                        <span class="library-image-placeholder library-author-placeholder" aria-hidden="true">AUTHOR</span>
                      <% } %>
                      <span><%= author.name %></span>
                    </div>
                  </td>
                  <td><%= author.country %></td>
                  <td><span class="library-id">#<%= author.author_id %></span></td>
                  <td>
                    <div class="library-row-actions">
                      <a class="library-text-link" href="/library/authors/<%= author.author_id %>/edit">Edit</a>
                      <form action="/library/authors/<%= author.author_id %>/delete" method="POST" onsubmit="return confirm('Remove this author and all of their books?');">
                        <button class="library-danger-link" type="submit">Remove</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <p class="library-note">Removing an author also removes all of their books.</p>
      <% } else { %>
        <p class="library-empty">No authors yet. Add an author before adding books.</p>
      <% } %>
    </section>
  </div>
</main>

<%- include('../partials/footer') %>
