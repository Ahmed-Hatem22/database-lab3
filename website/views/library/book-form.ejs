<%- include('../partials/header', { title, libraryStyles }) %>
<%- include('../partials/navbar') %>

<main class="main-content library-content">
  <div class="library-form-container">
    <a class="library-back-link" href="/library">&larr; Back to library</a>
    <section class="card library-form-card">
      <p class="library-eyebrow">LIBRARY COLLECTION</p>
      <h1 class="page-title"><%= book ? 'Edit book' : 'Add a book' %></h1>
      <p class="page-subtitle">Enter the book details and select its author.</p>

      <% if (errors.length) { %>
        <div class="library-alert" role="alert">
          <% errors.forEach(function(error) { %><p><%= error %></p><% }); %>
        </div>
      <% } %>

      <form action="<%= book ? `/library/books/${book.book_id}/edit` : '/library/books' %>" method="POST" enctype="multipart/form-data" class="library-form">
        <label class="form-group">
          <span class="form-label">Book title</span>
          <input class="form-input" type="text" name="title" maxlength="200" required value="<%= book ? book.title : '' %>">
        </label>
        <label class="form-group">
          <span class="form-label">Price</span>
          <input class="form-input" type="number" name="price" min="0" max="99999999.99" step="0.01" required value="<%= book ? Number(book.price).toFixed(2) : '' %>">
        </label>
        <label class="form-group">
          <span class="form-label">Author</span>
          <select class="form-input" name="author_id" required>
            <option value="">Choose an author</option>
            <% authors.forEach(function(author) { %>
              <option value="<%= author.author_id %>" <%= book && String(book.author_id) === String(author.author_id) ? 'selected' : '' %>><%= author.name %> (#<%= author.author_id %>)</option>
            <% }); %>
          </select>
          <% if (!authors.length) { %><span class="library-field-note">Add an author before creating a book.</span><% } %>
        </label>
        <label class="form-group">
          <span class="form-label">Book cover <span class="library-field-note">(optional, JPEG / PNG / WebP, up to 5 MB)</span></span>
          <input class="form-input library-file-input" type="file" name="image" accept="image/jpeg,image/png,image/webp">
        </label>
        <% if (book && book.cover_image) { %>
          <div class="library-current-image">
            <span class="form-label">Current cover</span>
            <img class="library-form-preview library-cover" src="/uploads/library/<%= book.cover_image %>" alt="Current cover of <%= book.title %>">
            <span class="library-field-note">Choose a new image to replace it. Leave the upload empty to keep this cover.</span>
          </div>
        <% } %>
        <div class="library-form-actions">
          <a class="btn btn-outline" href="/library">Cancel</a>
          <button class="btn btn-primary" type="submit" <%= authors.length ? '' : 'disabled' %>><%= book ? 'Save changes' : 'Add book' %></button>
        </div>
      </form>
    </section>
  </div>
</main>

<%- include('../partials/footer') %>
